\newlabel{tab:hyperparams}{{1}{3}{}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Convolutional Heuristic for Time of Disruption}{3}{}\protected@file@percent }
\newlabel{sub:disruption_time_diff_start}{{4a}{4}{}{subfigure.4.1}{}}
\newlabel{sub@sub:disruption_time_diff_start}{{a}{4}{}{subfigure.4.1}{}}
\newlabel{sub:disruption_time_diff_root}{{4b}{4}{}{subfigure.4.2}{}}
\newlabel{sub@sub:disruption_time_diff_root}{{b}{4}{}{subfigure.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces On the left, a histogram of the difference $\Delta t=t_0-t_D$ (See Eq~\eqref  {time_of_disrupt}). Most of our predictions are early, with a mean $\Delta t \approx \qty {-3.9}{\milli \s }$ (\ref {sub:disruption_time_diff_start}). On the right, a histogram of the difference $\Delta t=t_\mathrm  {root}-t_D$. The Gaussian is centered with $\mu \approx \qty {0.1}{\milli \s }$, $\sigma =\qty {1.0}{\milli \s }$ (\ref {sub:disruption_time_diff_root}). For both charts, we plot a Gaussian fit over the entire test set (blue) and a Gaussian fit excluding outliers where $|\Delta t|>3\sigma $ (orange). }}{4}{}\protected@file@percent }
\newlabel{fig:heuristic_diff}{{4}{4}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Two example shots (above) with their disruption heuristic $f(t)$ (below). On the left, we see shot \#125500 with a DIII-D label near the disruption start (Eq~\eqref  {time_of_disrupt}); on the right, we see shot \#178323 with a DIII-D label near the disruption root (Eq~\eqref  {time_of_disrupt_root}). }}{4}{}\protected@file@percent }
\newlabel{fig:heuristic}{{5}{4}{}{figure.5}{}}
\newlabel{current_raw}{{5}{4}{}{equation.5}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces On the left, a histogram of the difference $\Delta t$ between predicted start of disruption Eq~\eqref  {time_of_disrupt} and labeled time of disruption in milliseconds. Most of our predictions are early, with a mean $\Delta t \approx \qty {-4}{\milli \s }$ (\ref {sub:disruption_time_diff_start}). We plot a Gaussian fit to the entire test set (blue) and a Gaussian with no outliers within $3\sigma $ (orange). On the right, a histogram of the difference $\Delta t$ between heuristic root $t_\mathrm  {root}$ Eq~\eqref  {time_of_disrupt_root} and labeled time of disruption in milliseconds. The Gaussian is centered with $\mu \approx \qty {0}{\milli \s }$, $\sigma =\qty {1.1}{\milli \s }$ (\ref {sub:disruption_time_diff_root} ). }}{5}{}\protected@file@percent }
\newlabel{fig:heuristic_diff}{{5}{5}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Two example shots (above) with their disruption heuristic $f(t)$ (below). On the left, we see shot \#125500 with a DIII-D label near the disruption start (Eq~\eqref  {time_of_disrupt}); on the right, we see shot \#178323 with a DIII-D label near the disruption root (Eq~\eqref  {time_of_disrupt_root}). }}{5}{}\protected@file@percent }
\newlabel{fig:heuristic}{{6}{5}{}{figure.6}{}}
